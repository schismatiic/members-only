<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korova | Sign Up</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {firstRoute: "" , secondRoute: "log-in" , first: "Home" , second: "Log In" }) %>

        <h3 class="flex justify-center mt-4 text-2xl">
            Create an account
        </h3>
        <main class="flex flex-col flex-1 items-center">
            <form action="/sign-up" method="POST"
                class="flex flex-col w-full max-w-11/12 md:max-w-1/2 m-4 border border-white/20 p-4 gap-2">
                <label for="userFirstName">
                    First name
                </label>
                <input name="userFirstName" id="userFirstName" class="border border-white/20  px-4 py-2" type="text"
                    placeholder="Alex" required>

                <label for="userLastName">
                    Last name
                </label>
                <input name="userLastName" id="userLastName" class="border border-white/20  px-4 py-2" type="text"
                    placeholder="DeLarge" required>

                <label for="userUsername">
                    Username
                </label>
                <input name="userUsername" id="userUsername" class="border border-white/20  px-4 py-2" type="text"
                    placeholder="alexdelarge" required>

                <label for="userEmail">
                    Email
                </label>
                <input name="userEmail" id="userEmail" class="border border-white/20  px-4 py-2" type="email"
                    placeholder="alexthedroog@email.com" required>

                <label for="userPassword">
                    Password
                </label>
                <input name="userPassword" id="userPassword" class="border border-white/20  px-4 py-2" type="password"
                    placeholder="********" required>

                <label for="userConfirmPassword">
                    Confirm password
                </label>
                <input name="userConfirmPassword" id="userConfirmPassword" class="border border-white/20  px-4 py-2"
                    type="password" placeholder="********" required>

                <button
                    class="bg-white text-black px-4 py-2 cursor-pointer hover:bg-white/90 active:scale-95 mt-4 w-fit"
                    type="submit">Sign Up</button>
            </form>
            <% if (locals.errors) {%>
                <ul class="m-4 border border-white/20 p-4 w-fit">
                    <% errors.forEach(function(error) { %>
                        <li class="font-bold">
                            <%= error.msg %>
                        </li>
                        <% }); %>
                </ul>
                <% } %>
        </main>
        <%- include('footer') %>

</body>

</html>