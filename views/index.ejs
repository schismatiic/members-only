<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Корова</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {firstRoute: "log-in" , secondRoute: "sign-up" , first: "Log In" , second: "Sign Up" }) %>

        <main class="flex-1 mt-2">
            <div class="p-4 m-4 border border-white/20">
                <% if (messages.length!==0) { %>
                    <% messages.forEach(message=> { %>
                        <%= message.username %>
                            <% }); %>
                                <% } else {%>
                                    <p class="flex justify-center text-white/80">No messages yet.</p>
                                    <% } %>


            </div>

        </main>

        <%- include('footer') %>

</body>

</html>