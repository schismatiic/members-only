<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members only</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <header class="flex p-4 justify-between items-center border-b border-white/20">
        <h1 class="text-2xl font-bold">Members only</h1>
        <div class="flex items-center gap-2 md:gap-4">
            <a href="/log-in"
                class="text-white border border-white/20 px-4 py-2 cursor-pointer hover:bg-gray-900 active:scale-95">Log
                in</a>
            <a href="/sign-up"
                class="bg-white border border-white/20 text-black px-4 py-2 cursor-pointer hover:bg-white/90 active:scale-95">Sign
                up</a>
        </div>
    </header>
    <main class="flex-1 mt-2">
        <div class="p-4 m-4 border border-white/20">
            <% if (messages.length!==0) { %>
                <% messages.forEach(message=> { %>
                    <%= message.username %>
                        <% }); %>
                            <% } else {%>
                                <p class="flex justify-center text-white/80">No messages yet.</p>
                                <% } %>


        </div>

    </main>

    <%- include('footer') %>

</body>

</html>