<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Корова</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {user, route: "index" }) %>
        <main class="flex flex-col md:flex-row flex-1 mt-2 ">
            <div class="p-4 m-4 border border-white/20 md:w-8/12">
                <% if (messages.length!==0) { %>
                    <% messages.forEach(message=> { %>
                        <%= message.username %>
                            <% }); %>
                                <% } else {%>
                                    <p class="flex justify-center text-white/80">No messages yet.</p>
                                    <% } %>
            </div>
            <%- include("membership-card", {user}) %>
        </main>


        <%- include('footer') %>

</body>

</html>