<header class="flex p-4 justify-between items-center border-b border-white/20">
    <a href="/" class="active:scale-95">
        <h1 class="text-2xl font-extralight tracking-[0.35em]">Корова</h1>
    </a>
    <div class="flex items-center gap-2 md:gap-4">
        <% if (route==="log-in" ) { %>
            <a href="/"
                class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                Home
            </a>
            <a href="sign-up"
                class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                Sign Up
            </a>
            <% } else if (route==="sign-up" ) { %>
                <a href="/"
                    class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                    Home
                </a>
                <a href="log-in"
                    class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                    Log In
                </a>
                <% } else if (!user && route==="index" ) { %>
                    <a href="/auth/log-in"
                        class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                        Log In
                    </a>
                    <a href="/auth/sign-up"
                        class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                        Sign Up
                    </a>
                    <% } else if (user && route==="index" && !user.membership_status ) { %>
                        <a href="/membership/become"
                            class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                            Become a member
                        </a>
                        <a href="/auth/log-out"
                            class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                            Log Out
                        </a>
                        <% } else if (user && !user.membership_status && route==="become" ) { %>
                            <a href="/"
                                class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                                Home
                            </a>
                            <a href="/auth/log-out"
                                class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                                Log Out
                            </a>
                            <% } else if (user && user.membership_status && route==="message" ) { %>
                                <a href="/"
                                    class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                                    Home
                                </a>
                                <a href="/auth/log-out"
                                    class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                                    Log Out
                                </a>
                                <% } else if (user && user.membership_status && route==="admin" ) { %>
                                    <a href="/"
                                        class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                                        Home
                                    </a>
                                    <a href="/auth/log-out"
                                        class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                                        Log Out
                                    </a>
                                    <% } else if (user && user.admin_status && route!=="admin" ) { %>
                                        <a href="/auth/log-out"
                                            class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                                            Log Out
                                        </a>
                                        <% } else if (user && user.membership_status && route!=="admin" ) { %>
                                            <a href="/membership/admin"
                                                class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                                                Become an admin
                                            </a>
                                            <a href="/auth/log-out"
                                                class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                                                Log Out
                                            </a>
                                            <% } %>
    </div>
</header>