<header class="flex p-4 justify-between items-center border-b border-white/20">
    <h1 class="text-2xl font-extralight">Korova</h1>
    <div class="flex items-center gap-2 md:gap-4">
        <a href="/<%= firstRoute %>"
            class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
            <%= first%>
        </a>
        <a href="/<%= secondRoute %>"
            class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
            <%= second%>
        </a>
    </div>
</header>