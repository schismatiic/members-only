<div class="m-4 mt-0 md:mt-4 md:ml-0 md:w-4/12">
    <div class="h-full border p-4 border-white/20">
        <h2 class="text-3xl font-extralight text-center tracking-[0.35em] border-b border-white/20 pb-4 -mx-4">
            <% if (!user) { %>
                Корова

                <% } else if (user) { %>
                    <%= user.username %>
                        <% } %>
        </h2>
        <% if (!user) { %>
            <h3 class="text-2xl mt-4 font-bold text-center">Welcome</h3>
            <p class="mt-2">
                Join the club and discover what lies inside Корова.
            </p>
            <ul class="mt-2">
                <li>- Join the club</li>
                <li>- Create your own posts </li>
            </ul>
            <div class="flex justify-center items-center gap-2 mt-4">
                <a href="auth/log-in"
                    class="text-white border border-white/20 px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">
                    Log In
                </a>
                <a href="auth/sign-up"
                    class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                    Sign Up
                </a>
            </div>
            <% } else if (user && user.admin_status) { %>
                <h3 class="text-2xl mt-4 font-bold text-center"> Welcome, admin</h3>
                <p class="mt-2">
                    You have full access to Корова.
                </p>
                <ul class="mt-2">
                    <li>- You can see who wrote each post</li>
                    <li>- You can create messages </li>
                    <li>- Manage the clubhouse </li>
                </ul>
                <% } else if (user && user.membership_status) { %>
                    <h3 class="text-2xl mt-4 font-bold text-center"> Welcome to the club</h3>
                    <p class="mt-2">
                        You're a member of Корова.
                    </p>
                    <ul class="mt-2">
                        <li>- You can see who wrote each post</li>
                        <li>- You can create messages </li>
                    </ul>
                    <h3 class="text-2xl mt-4 font-bold">Want more acces?</h3>
                    <p class="mt-2">
                        Become an admin and help manage the club.
                    </p>
                    <div class="flex justify-center">
                        <a href="membership/admin"
                            class="mt-4 bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                            Become an admin
                        </a>
                    </div>
                    <% } else if (user && !user.membership_status) { %>
                        <h3 class="text-2xl mt-4 font-bold text-center">Become a member</h3>
                        <p class="mt-2">
                            Join the club and gain access to everything inside Корова.
                        </p>
                        <ul class="mt-2">
                            <li>- See who wrote each post</li>
                            <li>- Create messages </li>
                        </ul>
                        <div class="flex justify-center">
                            <a href="membership/become"
                                class="mt-4 bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/90 active:scale-95">
                                Become a member
                            </a>
                        </div>
                        <% } %>

    </div>
</div>